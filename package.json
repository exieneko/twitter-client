  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "linkedom": "^0.18.15",
    "undici": "^8.12.3",
    "x-client-transaction-id": "^0.3.3"
